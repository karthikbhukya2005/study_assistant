# Copy this file to .env and fill in your key.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Any Gemini text model that supports JSON output works.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Port for the backend proxy (the Vite dev server forwards /api here).
PORT=8787
