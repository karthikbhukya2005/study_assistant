{
  "name": "flam-frontend-assignment",
  "private": true,
  "version": "1.0.0",
  "description": "Study assistant: paste notes, get AI-generated flashcards and a quiz rendered as interactive UI.",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n server,web -c blue,green \"npm:server\" \"npm:dev\"",
    "dev": "vite",
    "server": "tsx watch server/generate.ts",
    "build": "tsc --noEmit && vite build",
    "serve": "npm run build && cross-env NODE_ENV=production tsx server/generate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
